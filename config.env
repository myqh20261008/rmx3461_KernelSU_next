CONFIG_ENV=config.env

# ============================================================ Kernel source ==
#
# ★ 这一份是「Fork 版」★
# 用你自己的 Fork（= 上游 crDroid 的一比一快照），好处是：GitHub 的 Fork
# **不会自动同步上游**，所以 crDroid 之后往 17.0 推新提交时，你的 Fork 会停在
# 原地 → 版本串永远锁死在 5.4.302-qgki-gd02ffb5e3996。
#
# 使用前提：你已经在 GitHub 上 Fork 了
#   https://github.com/crdroidandroid/android_kernel_oneplus_sm8350
# 并且 Fork 里 17.0 分支的 HEAD 仍是 d02ffb5e3996（Fork 那一刻的快照就是它）。
#
# 如果还没 Fork，请直接用桌面的 config.env（上游版）。

KERNEL_SOURCE=https://github.com/myqh20261008/android_kernel_oneplus_sm8350
KERNEL_SOURCE_BRANCH=17.0
KERNEL_CONFIG=vendor/lahaina-qgki_defconfig

# device tree（sm8350-common/BoardConfigCommon.mk）里写的是：
#   BOARD_KERNEL_IMAGE_NAME := Image
# 不是 Image.gz / Image.gz-dtb。写错会报"找不到内核镜像"。
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# ============================================ 版本串（vermagic）—— 最关键 ===
#
# 你的 ROM 内核版本串：5.4.302-qgki-gd02ffb5e3996
#   5.4.302            ← Makefile 的 VERSION/PATCHLEVEL/SUBLEVEL
#   -qgki              ← CONFIG_LOCALVERSION
#   -gd02ffb5e3996     ← scripts/setlocalversion 读 git HEAD 生成的
#
# 内核开着 CONFIG_MODVERSIONS=y，ROM 里 vendor_dlkm 的预编译模块（wifi、触控、
# 音频等）加载时会严格校验这个版本串，差一个字符就全部加载失败。
#
# ⚠️ 这行**必须保留，不能空着**：我们在下面用 EXTRA_DEFCONFIG 改了 defconfig，
#    源码树因此变成 git "dirty"，setlocalversion 会输出 -dirty 后缀。
#    填了 KERNEL_NAME 后，Action 会把 setlocalversion 里的 -dirty 输出删掉。
KERNEL_NAME=qgki
ADD_LOCALVERSION_TO_FILENAME=false

CUSTOM_CMDS=
# 这棵树开着 CONFIG_LTO_CLANG=y + CONFIG_CFI_CLANG=y，链接必须用 lld
EXTRA_CMDS=LD=ld.lld

# =================================================================== Clang ==
#
# 用你 ROM 内核**一模一样**的编译器：clang 22.0.2 / LLD 22.0.2，即 AOSP r596125
# （从 adb shell cat /proc/version 里确认："based on r596125"）。
CLANG_BRANCH=main-kernel
CLANG_VERSION=r596125

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# KSU_VARIANT=none → 只编译内核，不做任何 KSU 集成。
# crDroid 的 17.0 源码里**已经自带 KernelSU-Next v3.4.0-legacy**。

KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=none
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
# ★ 核心修复：把 KSU 钩子从 5.4 上失效的 kprobes 切到 syscall table 模式 ★

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=CONFIG_KSU_MANUAL_HOOK=n CONFIG_KSU_KPROBES_HOOK=n CONFIG_KSU_SYSCALL_TABLE_HOOK=y CONFIG_DEBUG_KERNEL=y CONFIG_KALLSYMS=y CONFIG_KALLSYMS_ALL=y CONFIG_LOCALVERSION_AUTO=y

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false

BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
